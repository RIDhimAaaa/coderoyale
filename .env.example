# Copy to .env before running `docker compose up`.
# These defaults are for local development only — never reuse them in a deployed environment.

# --- api ---
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720
MATCH_DURATION_SECONDS=600
ELO_K_FACTOR=32

# --- executor ---
# Per-submission sandbox limits (applied to every throwaway container)
SANDBOX_WALL_TIMEOUT_SECONDS=8
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_TMPFS_MB=32
MAX_CONCURRENCY=4
